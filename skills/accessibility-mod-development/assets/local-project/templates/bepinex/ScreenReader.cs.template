using System;
using System.Runtime.InteropServices;

namespace NAMESPACE
{
    /// <summary>
    /// Wrapper for Tolk screenreader library.
    /// Provides simple methods to announce text via NVDA, JAWS, or other screenreaders.
    ///
    /// REQUIREMENTS:
    /// - Tolk.dll must be in the game folder (where the .exe is)
    /// - nvdaControllerClient64.dll (for 64-bit) or nvdaControllerClient32.dll (for 32-bit)
    ///   must also be in the game folder
    ///
    /// Download Tolk from: https://github.com/ndarilek/tolk/releases
    /// </summary>
    public static class ScreenReader
    {
        #region Native Imports

        // Tolk's C API returns 1-byte bools. Without [return: MarshalAs(UnmanagedType.I1)]
        // the CLR reads a 4-byte Win32 BOOL, so the upper three bytes are whatever the
        // callee left in the register - "no screenreader" can come back as true.
        // Reading only the low byte is correct for a 1-byte bool AND for a real BOOL.

        [DllImport("Tolk.dll")]
        private static extern void Tolk_Load();

        [DllImport("Tolk.dll")]
        private static extern void Tolk_Unload();

        [DllImport("Tolk.dll")]
        [return: MarshalAs(UnmanagedType.I1)]
        private static extern bool Tolk_IsLoaded();

        [DllImport("Tolk.dll")]
        [return: MarshalAs(UnmanagedType.I1)]
        private static extern bool Tolk_HasSpeech();

        [DllImport("Tolk.dll", CharSet = CharSet.Unicode)]
        [return: MarshalAs(UnmanagedType.I1)]
        private static extern bool Tolk_Output(string text, [MarshalAs(UnmanagedType.I1)] bool interrupt);

        [DllImport("Tolk.dll")]
        [return: MarshalAs(UnmanagedType.I1)]
        private static extern bool Tolk_Silence();

        [DllImport("Tolk.dll", CharSet = CharSet.Unicode)]
        private static extern IntPtr Tolk_DetectScreenReader();

        #endregion

        #region Fields

        /// <summary>Milliseconds between reconnect attempts while no screenreader answers.</summary>
        private const int ReprobeIntervalMs = 3000;

        private static bool _available = false;
        private static bool _initialized = false;

        // Tolk.dll missing is permanent for this process - stop probing so Say()
        // does not throw DllNotFoundException on every single announcement.
        private static bool _dllMissing = false;

        private static int _lastProbeTicks = 0;
        private static bool _muteWarningLogged = false;
        private static bool _outputFailureLogged = false;

        #endregion

        #region Public Methods

        /// <summary>
        /// Initializes Tolk. Call once at mod startup.
        /// A missing screenreader is not fatal: <see cref="Say"/> keeps probing, so a
        /// screenreader started after the game still gets announcements.
        /// </summary>
        public static void Initialize()
        {
            if (_initialized) return;
            _initialized = true;

            if (TryConnect(out string srName))
            {
                LogInfo($"Screenreader detected: {srName}");
            }
            else if (!_dllMissing)
            {
                LogWarning(
                    "No screenreader detected yet - announcements are logged only. " +
                    "Start NVDA or JAWS at any time, the mod reconnects on its own.");
            }
        }

        /// <summary>
        /// Announces text via the screenreader.
        /// When Main.DebugMode is true, also logs all announcements via DebugLogger.
        /// </summary>
        /// <param name="text">Text to speak</param>
        /// <param name="interrupt">If true, stops current speech before speaking</param>
        public static void Say(string text, bool interrupt = true)
        {
            if (string.IsNullOrEmpty(text)) return;

            // Log all announcements when debug mode is enabled
            DebugLogger.LogScreenReader(text);

            if (!_available && !TryReconnect())
            {
                // Warn once instead of dropping silently - a mute mod looks exactly
                // like a working one to a blind user.
                if (!_muteWarningLogged)
                {
                    _muteWarningLogged = true;
                    LogWarning($"No screenreader connected - announcement dropped: \"{text}\"");
                }
                return;
            }

            try
            {
                if (!Tolk_Output(text, interrupt) && !_outputFailureLogged)
                {
                    _outputFailureLogged = true;
                    LogWarning($"Tolk_Output returned false - announcement may not have been spoken: \"{text}\"");
                }
            }
            catch (Exception ex)
            {
                // Drop the connection so the next announcement re-probes instead of
                // throwing again on a screenreader that went away mid-session.
                _available = false;
                LogWarning($"ScreenReader.Say failed: {ex.Message}");
            }
        }

        /// <summary>
        /// Queued announcement - waits for current speech to finish before speaking.
        /// Use for additional info after a main announcement.
        /// Internally calls Tolk_Output(text, false).
        /// </summary>
        /// <param name="text">Text to speak after current speech finishes</param>
        public static void SayQueued(string text)
        {
            Say(text, false);
        }

        /// <summary>
        /// Stops current speech immediately.
        /// </summary>
        public static void Stop()
        {
            if (!_available) return;

            try
            {
                Tolk_Silence();
            }
            catch (Exception ex)
            {
                LogWarning($"ScreenReader.Stop failed: {ex.Message}");
            }
        }

        /// <summary>
        /// Shuts down Tolk. Call when the game closes.
        /// </summary>
        public static void Shutdown()
        {
            if (!_initialized) return;

            try
            {
                Tolk_Unload();
            }
            catch (Exception ex)
            {
                LogWarning($"ScreenReader.Shutdown failed: {ex.Message}");
            }

            _initialized = false;
            _available = false;
        }

        /// <summary>
        /// True while a screenreader is connected. Can change during the session:
        /// it turns true when the user starts a screenreader later, and false when one
        /// disappears. Never cache this value - query it each time.
        /// </summary>
        public static bool IsAvailable => _available;

        #endregion

        #region Private Methods

        /// <summary>
        /// (Re-)connects to Tolk and checks whether a screenreader can speak right now.
        /// Safe to call repeatedly: Tolk is only loaded while it reports itself unloaded.
        /// </summary>
        /// <param name="screenReaderName">Detected screenreader name, null when none answered.</param>
        /// <returns>True when a screenreader is ready to speak.</returns>
        private static bool TryConnect(out string screenReaderName)
        {
            screenReaderName = null;
            if (_dllMissing) return false;

            try
            {
                if (!Tolk_IsLoaded()) Tolk_Load();

                _available = Tolk_IsLoaded() && Tolk_HasSpeech();
                if (!_available) return false;

                IntPtr srNamePtr = Tolk_DetectScreenReader();
                screenReaderName = srNamePtr != IntPtr.Zero
                    ? Marshal.PtrToStringUni(srNamePtr)
                    : "Unknown";
                return true;
            }
            catch (DllNotFoundException)
            {
                _dllMissing = true;
                _available = false;
                LogError("Tolk.dll not found! Place BOTH Tolk.dll AND nvdaControllerClient64.dll (or 32-bit version) in the game folder.");
                return false;
            }
            catch (Exception ex)
            {
                _available = false;
                LogError($"Tolk connection attempt failed: {ex.Message}");
                return false;
            }
        }

        /// <summary>
        /// Throttled reconnect attempt used by <see cref="Say"/>. Probing on every
        /// announcement would call into Tolk hundreds of times per minute, so retries
        /// are limited to one per <see cref="ReprobeIntervalMs"/>.
        /// </summary>
        private static bool TryReconnect()
        {
            if (_dllMissing || !_initialized) return false;

            // Unchecked subtraction stays correct when Environment.TickCount wraps
            // (it does after ~24.8 days of uptime).
            int now = Environment.TickCount;
            if (unchecked(now - _lastProbeTicks) < ReprobeIntervalMs) return false;
            _lastProbeTicks = now;

            if (!TryConnect(out string srName)) return false;

            // Connection is back - allow both warnings to fire again on the next loss.
            _muteWarningLogged = false;
            _outputFailureLogged = false;
            LogInfo($"Screenreader connected: {srName}");
            return true;
        }

        // Main.Log is assigned in Main.Awake(). ScreenReader is also reachable from
        // Harmony patches and static initializers, so never dereference it blindly -
        // an NRE inside the logging call would hide the very problem being reported.

        private static void LogInfo(string message)
        {
            if (Main.Log != null) Main.Log.LogInfo(message);
            else Console.WriteLine($"[MODNAME] {message}");
        }

        private static void LogWarning(string message)
        {
            if (Main.Log != null) Main.Log.LogWarning(message);
            else Console.WriteLine($"[MODNAME] WARNING: {message}");
        }

        private static void LogError(string message)
        {
            if (Main.Log != null) Main.Log.LogError(message);
            else Console.WriteLine($"[MODNAME] ERROR: {message}");
        }

        #endregion
    }
}
